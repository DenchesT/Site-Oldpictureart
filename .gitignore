# ============================================================
#  Что НЕ должно попасть в репозиторий
#
#  Репозиторий публичный: всё, что здесь окажется, увидит любой.
#  Поэтому первый раздел — не про порядок, а про безопасность.
# ============================================================

# --- Доступ к вашему аккаунту Telegram --------------------------------
#
# Файл сессии — это вход в ваш Telegram без пароля и без кода из СМС.
# Двухфакторная защита от его утечки не спасает: тот, кто его получит,
# уже внутри. Опаснее утекшего пароля.
*.session
*.session-journal
my_session.session

# --- Ключи и учётные данные -------------------------------------------
#
# API_ID, API_HASH и телефон читаются из .env — в коде их нет.
.env
*.key
*.pem
*.secret

# --- Мусор системы и редакторов ---------------------------------------
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Зависимости ------------------------------------------------------
#
# node_modules ставится для проверок в tests/ и весит десятки мегабайт.
# Это чужой код, который ставится одной командой, — в репозитории ему
# не место.
node_modules/

# --- Окружение Python -------------------------------------------------
venv/
.venv/

# --- Временное --------------------------------------------------------
*.log
*.tmp
*.bak
*~
*.orig
*.rej

# --- Папка, куда уборка складывает ненужные картинки -------------------
#
# python optimize_images.py --apply --keep переносит сюда файлы, на
# которые никто не ссылается. Это сотни мегабайт, и в репозитории им
# делать нечего: просмотрите папку и удалите руками.
docs/_unused/
