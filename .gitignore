# ============================================================
#  Что НЕ должно попасть в репозиторий
#
#  Репозиторий публичный: всё, что здесь окажется, увидит любой.
#  Поэтому первый раздел — не про порядок, а про безопасность.
# ============================================================

# --- Доступ к вашему аккаунту Telegram --------------------------------
#
# Файл сессии — это вход в ваш Telegram без пароля и без кода из СМС.
# Двухфакторная защита от его утечки не спасает: тот, кто его получит,
# уже внутри. Опаснее утекшего пароля.
*.session
*.session-journal
my_session.session

# --- Ключи и учётные данные -------------------------------------------
#
# API_ID, API_HASH и телефон читаются из .env — в коде их нет.
.env
*.key
*.pem
*.secret

# --- Мусор системы и редакторов ---------------------------------------
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Зависимости ------------------------------------------------------
#
# node_modules ставится для проверок в tests/ и весит десятки мегабайт.
# Это чужой код, который ставится одной командой, — в репозитории ему
# не место.
node_modules/

# --- Окружение Python -------------------------------------------------
#
# .conda — окружение conda внутри папки проекта, тысячи чужих файлов.
# Сейчас его спасает только то, что conda кладёт внутрь собственный
# .gitignore. Полагаться на это не стоит: пересоздадут окружение другой
# командой — и всё уедет в репозиторий.
venv/
.venv/
.conda/

# --- Временное --------------------------------------------------------
#
# *.log.1 и *.log.2 — прошлые сборки: журнал обрезается по размеру и
# складывает предыдущие рядом, под другим расширением.
*.log
*.log.[0-9]
*.tmp
*.bak
*~
*.orig
*.rej

# --- Прежний вариант сайта --------------------------------------------
#
# output — целиком собранный сайт от мая, до переезда в docs: 243 файла
# и 59 МБ, из них одна картинка на 33 МБ. Ни на что не влияет, но и в
# репозитории ему не место. Когда решите, что он больше не нужен ни для
# сверки, ни для памяти, — папку можно просто удалить с диска.
output/

# --- Папка, куда уборка складывает ненужные картинки -------------------
#
# python optimize_images.py --apply --keep переносит сюда файлы, на
# которые никто не ссылается. Это сотни мегабайт, и в репозитории им
# делать нечего: просмотрите папку и удалите руками.
docs/_unused/


# ============================================================
#  А это, наоборот, ДОЛЖНО лежать в репозитории
#
#  processed_ids.json — список постов канала, которые сборка уже
#  обработала. Он не секрет и когда-то стоял выше, среди файлов
#  сессии. Из-за этого его потеряли — и сборка, решив, что не видела
#  канал ни разу, перекачала все работы заново: 800 МБ дублей,
#  переехавшие адреса и мёртвые ссылки на прежние страницы.
#
#  Не добавляйте его сюда.
# ============================================================
